      rel="stylesheet"
    />
    <script>
      try {
        // Birinchi kadrda "oq chaqnash" bo'lmasligi uchun mavzu React'dan oldin qo'llanadi.
        // Standart: tun rejimi (foydalanuvchi tanlamaguncha).
        const t = localStorage.getItem('namdu-theme')
        const dark = t === 'system' ? matchMedia('(prefers-color-scheme: dark)').matches : t !== 'light'
        document.documentElement.classList.toggle('dark', dark)
        document.querySelector('meta[name="theme-color"]').setAttribute('content', dark ? '#040b19' : '#e8f0fb')
      } catch {}
    </script>
