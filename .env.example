# FizikaLab Backend Environment Configuration
# Copy this file to .env.local for local overrides, or set these as Encrypted Environment Variables in Vercel.

# Session signing secret (set a strong random string in production!)
AUTH_SECRET=replace-with-strong-32-char-random-secret-key

# Exclusive Administrator credentials (store ONLY in Vercel Encrypted Env Vars / .env.local)
# Accepts combined "email:password" or JSON {"email":"...","password":"..."}
ADMIN_SECRET=

# Optional separate fields if not using combined ADMIN_SECRET:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# PostgreSQL connection string for Vercel / Neon / Supabase production persistence.
# Leave unset locally to use built-in SQLite at ./data/fizika_lab.db automatically.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
