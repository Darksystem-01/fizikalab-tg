# ==============================================================================
# FIZIKALAB REELS — ENVIRONMENT CONFIGURATION TEMPLATE
# Nusxa oling va `.env.local` nomi bilan saqlang. Vercel'ga faqat qiymatlarni kiriting.
# HECH QACHON haqiqiy maxfiy sirlarni git repoga commit qilmang!
# ==============================================================================

# 1. Baza (Neon PostgreSQL)
# Ilova runtime uchun PgBouncer bilan pooled URL:
DATABASE_URL=postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Migratsiyalar va Drizzle-kit uchun to'g'ridan-to'g'ri unpooled URL:
DATABASE_URL_UNPOOLED=postgres://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Ilova Asosiy Domeni
APP_URL=https://fizikalab.uz

# 3. Kriptografiya va Sessiya Sirlari (Kamida 32-belgili tasodifiy satr)
SESSION_SECRET=replace-with-64-char-hex-random-string-for-session-tokens
PHONE_HMAC_SECRET=replace-with-64-char-hex-random-string-for-phone-hmac
PHONE_ENCRYPTION_KEY=replace-with-32-byte-hex-key-for-aes-256-gcm
OTP_HMAC_SECRET=replace-with-64-char-hex-random-string-for-otp-hmac

# 4. SMS Gateway (Eskiz.uz)
ESKIZ_EMAIL=user@example.com
ESKIZ_PASSWORD=your-eskiz-api-password
ESKIZ_FROM=4546

# 5. Rate Limiting & Distributed Cache (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://sample-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# 6. Realtime University Chat (Ably)
ABLY_API_KEY=your-ably-api-key-root

# 7. Media Saqlash (Vercel Blob yoki Cloudflare R2)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_sample_token

# 8. Botdan Himoya (Cloudflare Turnstile - ixtiyoriy)
TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# 9. Boshlang'ich Tizim Administratori
# Ro'yxatdan o'tganda avtomatik 'admin' roli beriladigan O'zbekiston telefon raqami
INITIAL_ADMIN_PHONE=+998901234567

# 10. Telegram Bot Integratsiyasi (Mavjud @Fizikatuitbot)
TELEGRAM_BOT_TOKEN=
